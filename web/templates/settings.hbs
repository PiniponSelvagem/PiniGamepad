<section class="app-layout">
    {{> nav}}

    <div class="settings-page">
        <section class="settings-group">
            <h2 class="settings-section-label">Miscellaneous</h2>
            <div class="settings-row">
                <input type="text" id="message-input" class="text-input" placeholder="Type a message">
                <button id="send-message" class="app-button" type="button">Send</button>
            </div>
        </section>

        <section class="settings-group">
            <h2 class="settings-section-label">Board</h2>
            <div class="settings-row settings-row-toggle">
                <span class="settings-label">Turbo</span>
                <button class="toggle" type="button" aria-pressed="false" data-setting-key="turbo">
                    <span class="toggle-thumb"></span>
                </button>
            </div>
            <div class="settings-row settings-row-toggle">
                <span class="settings-label">Debug</span>
                <button class="toggle debug-toggle" type="button" aria-pressed="false" data-setting-key="debugMode" data-toggle-class="debug-mode">
                    <span class="toggle-thumb"></span>
                </button>
            </div>
        </section>
    </div>
</section>
