<section class="app-layout">
    {{> nav}}

    <div class="settings-page">
        <section class="settings-group">
            <h2 class="settings-section-label">{{language.settings.sections.controller}}</h2>
            <div class="settings-row settings-row-select">
                <span class="settings-label">{{language.settings.modelEmulation.label}}</span>
                <select class="settings-select" data-setting-key="controllerModel">
                    {{#each settingsOptions.controllerModel}}
                    <option value="{{value}}">{{label}}</option>
                    {{/each}}
                </select>
            </div>
        </section>

        <section class="settings-group">
            <h2 class="settings-section-label">{{language.settings.sections.system}}</h2>
            <div class="settings-row settings-row-select">
                <span class="settings-label">{{language.settings.sleepTimeout.label}}</span>
                <select class="settings-select" data-setting-key="sleepTimeout">
                    {{#each settingsOptions.sleepTimeout}}
                    <option value="{{value}}">{{label}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="settings-row settings-row-toggle">
                <span class="settings-label">{{language.settings.alwaysSendInputState}}</span>
                <button class="toggle" type="button" data-pressed="false" data-setting-key="inputReportAlways">
                    <span class="toggle-thumb"></span>
                </button>
            </div>
            <div class="settings-row settings-row-led">
                <span class="settings-label">{{language.settings.ledColor}}</span>
                <div class="led-color-control">
                    <span class="led-color-value">#FF9F1C</span>
                    <input class="led-color-input" id="led-color" type="color" value="#ff9f1c" data-setting-key="ledColor">
                </div>
            </div>
        </section>

        <section class="settings-group">
            <h2 class="settings-section-label">{{language.settings.sections.developer}}</h2>
            <div class="settings-row settings-row-toggle">
                <span class="settings-label">{{language.settings.debug}}</span>
                <button class="toggle debug-toggle" type="button" data-pressed="false" data-setting-key="debugMode" data-toggle-class="debug-mode">
                    <span class="toggle-thumb"></span>
                </button>
            </div>
        </section>
    </div>
</section>
