<section class="app-layout">
    {{> nav}}

    <div class="settings-page">
        <section class="settings-group">
            <h2 class="settings-section-label">{{language.settings.sections.controller}}</h2>
            <div class="settings-row">
                <span class="settings-label">{{language.settings.controllerModel.label}}</span>
                <select class="settings-select" data-setting-key="controllerModel">
                    {{#each settingValues.controllerModel}}
                    <option value="{{this}}">{{lookup @root.language.settings.controllerModel.option this}}</option>
                    {{/each}}
                </select>
            </div>
        </section>

        <section class="settings-group">
            <h2 class="settings-section-label">{{language.settings.sections.system}}</h2>
            <div class="settings-row">
                <span class="settings-label">{{language.settings.sleepTimeout.label}}</span>
                <select class="settings-select" data-setting-key="sleepTimeout">
                    {{#each settingValues.sleepTimeout}}
                    <option value="{{this}}">{{lookup @root.language.settings.sleepTimeout.option this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="settings-row">
                <span class="settings-label">{{language.settings.inputReportAlways}}</span>
                <button class="toggle" type="button" data-pressed="false" data-setting-key="inputReportAlways">
                    <span class="toggle-thumb"></span>
                </button>
            </div>
            <div class="settings-row">
                <span class="settings-label">{{language.settings.ledColor}}</span>
                <div class="led-color-control">
                    <span class="led-color-value">#FF9F1C</span>
                    <input class="led-color-input" type="color" value="#ff9f1c" data-setting-key="ledColor">
                </div>
            </div>
        </section>

        <section class="settings-group">
            <h2 class="settings-section-label">{{language.settings.sections.developer}}</h2>
            <div class="settings-row">
                <span class="settings-label">{{language.settings.debugMode}}</span>
                <button class="toggle" type="button" data-pressed="{{debugMode}}" data-setting-key="debugMode">
                    <span class="toggle-thumb"></span>
                </button>
            </div>
        </section>
    </div>
</section>
