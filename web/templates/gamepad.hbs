<section class="app-layout">
    {{> nav}}

    <div class="controls">
        <div class="control-shoulder">
            <div class="app-button control-trigger" data-analog="LT">
                <span>LT</span>
            </div>
            <button class="app-button" data-input="LB">LB</button>
        </div>
        <div class="control-shoulder">
            <div class="app-button control-trigger" data-analog="RT">
                <span>RT</span>
            </div>
            <button class="app-button" data-input="RB">RB</button>
        </div>

        <div class="control-dpad">
            <button data-input="UP">&#9650;</button>
            <button data-input="LEFT">&#9664;</button>
            <button data-input="RIGHT">&#9654;</button>
            <button data-input="DOWN">&#9660;</button>
        </div>
        <div class="control-utility">
            <div class="utility-group">
                <button class="app-button" data-input="MACRO">MACRO</button>
                <button class="app-button" data-input="SELECT">SELECT</button>
            </div>
            <div class="utility-group">
                <button class="app-button" data-input="HOME">HOME</button>
                <button class="app-button" data-input="START">START</button>
            </div>
        </div>
        <div class="control-actions">
            <button class="control-action action-y" data-input="Y">Y</button>
            <button class="control-action action-b" data-input="B">B</button>
            <button class="control-action action-a" data-input="A">A</button>
            <button class="control-action action-x" data-input="X">X</button>
        </div>
        <div class="control-joysticks">
            <div class="joystick-group">
                <div class="joystick" data-axis="LS">
                    <div class="joystick-base">
                        <div class="joystick-knob">L</div>
                    </div>
                </div>
                <button class="app-button" data-input="L3">L3</button>
            </div>
            <div class="joystick-group">
                <div class="joystick" data-axis="RS">
                    <div class="joystick-base">
                        <div class="joystick-knob">R</div>
                    </div>
                </div>
                <button class="app-button" data-input="R3">R3</button>
            </div>
        </div>
    </div>

</section>
