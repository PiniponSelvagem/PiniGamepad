<section class="app-layout">
    {{> nav}}

    <div class="controls">
        <div class="control-shoulder">
            <div class="app-button control-trigger" data-analog="LT">
                <span>{{language.controller.controls.leftTrigger}}</span>
            </div>
            <button class="app-button" data-input="LB">{{language.controller.controls.leftBumper}}</button>
        </div>
        <div class="control-shoulder">
            <div class="app-button control-trigger" data-analog="RT">
                <span>{{language.controller.controls.rightTrigger}}</span>
            </div>
            <button class="app-button" data-input="RB">{{language.controller.controls.rightBumper}}</button>
        </div>

        <div class="control-dpad">
            <button data-input="UP">{{language.controller.controls.up}}</button>
            <button data-input="LEFT">{{language.controller.controls.left}}</button>
            <button data-input="RIGHT">{{language.controller.controls.right}}</button>
            <button data-input="DOWN">{{language.controller.controls.down}}</button>
        </div>
        <div class="control-utility">
            <div class="utility-group">
                <button class="app-button" data-input="MACRO">{{language.controller.controls.macro}}</button>
                <button class="app-button" data-input="SELECT">{{language.controller.controls.select}}</button>
            </div>
            <div class="utility-group">
                <button class="app-button" data-input="HOME">{{language.controller.controls.home}}</button>
                <button class="app-button" data-input="START">{{language.controller.controls.start}}</button>
            </div>
        </div>
        <div class="control-actions">
            <button class="control-action action-y" data-input="Y">{{language.controller.controls.actionY}}</button>
            <button class="control-action action-b" data-input="B">{{language.controller.controls.actionB}}</button>
            <button class="control-action action-a" data-input="A">{{language.controller.controls.actionA}}</button>
            <button class="control-action action-x" data-input="X">{{language.controller.controls.actionX}}</button>
        </div>
        <div class="control-joysticks">
            <div class="joystick-group">
                <div class="joystick" data-axis="LS">
                    <div class="joystick-base">
                        <div class="joystick-knob">{{language.controller.controls.leftStick}}</div>
                    </div>
                </div>
                <button class="app-button" data-input="L3">{{language.controller.controls.leftStickButton}}</button>
            </div>
            <div class="joystick-group">
                <div class="joystick" data-axis="RS">
                    <div class="joystick-base">
                        <div class="joystick-knob">{{language.controller.controls.rightStick}}</div>
                    </div>
                </div>
                <button class="app-button" data-input="R3">{{language.controller.controls.rightStickButton}}</button>
            </div>
        </div>
    </div>

</section>
