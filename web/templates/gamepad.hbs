<section class="app-layout">
    {{> nav}}

    <div class="controls">
        <div class="control-shoulder">
            <div class="app-button control-trigger" data-analog="LT">
                <span>{{language.controller.LT}}</span>
            </div>
            <button class="app-button" data-input="LB">{{language.controller.LB}}</button>
        </div>
        <div class="control-shoulder">
            <div class="app-button control-trigger" data-analog="RT">
                <span>{{language.controller.RT}}</span>
            </div>
            <button class="app-button" data-input="RB">{{language.controller.RB}}</button>
        </div>

        <div class="control-dpad">
            <button data-input="UP">{{language.controller.UP}}</button>
            <button data-input="LEFT">{{language.controller.LEFT}}</button>
            <button data-input="RIGHT">{{language.controller.RIGHT}}</button>
            <button data-input="DOWN">{{language.controller.DOWN}}</button>
        </div>
        <div class="control-utility">
            <div class="utility-group">
                <button class="app-button" data-input="MACRO">{{language.controller.MACRO}}</button>
                <button class="app-button" data-input="SELECT">{{language.controller.SELECT}}</button>
            </div>
            <div class="utility-group">
                <button class="app-button" data-input="HOME">{{language.controller.HOME}}</button>
                <button class="app-button" data-input="START">{{language.controller.START}}</button>
            </div>
        </div>
        <div class="control-actions">
            <button class="control-action action-y" data-input="Y">{{language.controller.Y}}</button>
            <button class="control-action action-b" data-input="B">{{language.controller.B}}</button>
            <button class="control-action action-a" data-input="A">{{language.controller.A}}</button>
            <button class="control-action action-x" data-input="X">{{language.controller.X}}</button>
        </div>
        <div class="control-joysticks">
            <div class="joystick-group">
                <div class="joystick" data-axis="LS">
                    <div class="joystick-base">
                        <div class="joystick-knob">{{language.controller.LS}}</div>
                    </div>
                </div>
                <button class="app-button" data-input="L3">{{language.controller.L3}}</button>
            </div>
            <div class="joystick-group">
                <div class="joystick" data-axis="RS">
                    <div class="joystick-base">
                        <div class="joystick-knob">{{language.controller.RS}}</div>
                    </div>
                </div>
                <button class="app-button" data-input="R3">{{language.controller.R3}}</button>
            </div>
        </div>
    </div>
</section>
