<section class="app-layout">
    {{> nav}}

    <div class="controller-controls">
        <div class="shoulder-control">
            <div class="trigger-control" data-analog="LT">
                <span>LT</span>
            </div>
            <button data-input="LB">LB</button>
        </div>
        <div class="shoulder-control">
            <div class="trigger-control" data-analog="RT">
                <span>RT</span>
            </div>
            <button data-input="RB">RB</button>
        </div>

        <div class="dpad">
            <button data-input="UP">&#9650;</button>
            <button data-input="LEFT">&#9664;</button>
            <button data-input="RIGHT">&#9654;</button>
            <button data-input="DOWN">&#9660;</button>
        </div>
        <div class="utility-controls">
            <div class="utility-group">
                <button data-input="MACRO">MACRO</button>
                <button data-input="SELECT">SELECT</button>
            </div>
            <div class="utility-group">
                <button data-input="HOME">HOME</button>
                <button data-input="START">START</button>
            </div>
        </div>
        <div class="actions">
            <button class="action action-y" data-input="Y">Y</button>
            <button class="action action-b" data-input="B">B</button>
            <button class="action action-a" data-input="A">A</button>
            <button class="action action-x" data-input="X">X</button>
        </div>
        <div class="axes-row">
            <div class="joystick-group">
                <div class="joystick" data-axis="LS">
                    <div class="joystick-base">
                        <div class="joystick-knob">L</div>
                    </div>
                </div>
                <button class="axis-button" data-input="L3">L3</button>
            </div>
            <div class="joystick-group">
                <div class="joystick" data-axis="RS">
                    <div class="joystick-base">
                        <div class="joystick-knob">R</div>
                    </div>
                </div>
                <button class="axis-button" data-input="R3">R3</button>
            </div>
        </div>
    </div>

</section>
